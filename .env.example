# Compose reads this file for the variables it interpolates into `docker-compose.arc.yml`. The
# services read `.env.arcTestnet` instead, through their entrypoint.
#
# PUBLIC_HOST is the host name the proxy answers on and asks Let's Encrypt to certify.
PUBLIC_HOST=example.com

# Empty means Let's Encrypt production, which is what issues a certificate a browser trusts. Point
# it at the staging endpoint while the routing is being proven:
#
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=
