# Shared.

ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002

# Filled in after deployment.
SEALED_AUCTION_ADDRESS=

USDC_ADDRESS=0x3600000000000000000000000000000000000000
USDC_DECIMALS=6

RELAY_URL=http://localhost:8787

# The suppliers price with a model, so every agent needs this.
ANTHROPIC_API_KEY=

# The supplier's own booking API. Sealed into every bid, and read only inside the enclave.
BOOKING_URL=https://api.liteapi.travel/v3.0
BOOKING_API_KEY=

# The X25519 private half, base64, as the workflow secret carries it. Generated on the first
# local deployment. Everything sealed to the matching public half stops opening if it changes.
ENCLAVE_PRIVATE_KEY=

BUYER_PRIVATE_KEY=
BUYER_ADDRESS=0x746e3d03D7bA18657DE97eE95Aa1a1654E925d4d

