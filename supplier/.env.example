# One supplier agent. Run three copies with three of these, one per configuration in config/.
#
# An agent holds its own key, its own booking credentials and nothing else. It never holds the
# policy or the enclave private key.

# The model that prices the bid.
ANTHROPIC_API_KEY=

# Which wallet signs the bid and the chain calls: `circle` or `local`. Defaults to `local`.
AGENT_SIGNER=local

# AGENT_SIGNER=circle. The agent's Circle Agent Stack wallet, provisioned and opened by
# `circle wallet login <email> --testnet`. The session lasts 28 days and the CLI holds it, so
# nothing else goes here.
CIRCLE_WALLET_ADDRESS=

# AGENT_SIGNER=local. A viem externally owned account. Demo keys only.
AGENT_PRIVATE_KEY=

# This supplier's own booking API. Sealed into the envelope; the enclave books the winner with it.
BOOKING_URL=https://api.liteapi.travel/v3.0
BOOKING_API_KEY=
