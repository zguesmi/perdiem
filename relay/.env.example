# The relay holds both tokens, because it is the one checking them.

RELAY_PORT=8787

# Supplier agents hold this one. It can write a sealed bid and read nothing.
RELAY_WRITE_TOKEN=

# The workflow holds this one. An agent that had it could read a rival's price.
RELAY_READ_TOKEN=

# Largest sealed bid the relay will store, in bytes.
RELAY_MAX_BID_BYTES=8192
