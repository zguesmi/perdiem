# One file per network, named after the Hardhat network it targets. Copy this one to
# `.env.localhost`.
#   set -a; source .env.localhost; set +a

ARC_RPC_URL=http://127.0.0.1:8545
ARC_CHAIN_ID=5042002

# Filled in after deployment. Arc has a real USDC, so only the auction address is deployed.
SEALED_AUCTION_ADDRESS=
USDC_ADDRESS=
USDC_DECIMALS=6

RELAY_PORT=8787
RELAY_URL=http://localhost:8787

# The suppliers price with a model, so every agent needs this.
ANTHROPIC_API_KEY=

BOOKING_URL=https://api.liteapi.travel/v3.0
BOOKING_API_KEY=

# The X25519 private half, base64, as the workflow secret carries it.
ENCLAVE_PRIVATE_KEY=

# `scripts/demo-sealed-bidding.sh` sets AGENT_PRIVATE_KEY per agent from the three supplier keys below.
AGENT_SIGNER=local
CIRCLE_WALLET_ADDRESS=

BUYER_ADDRESS=0x746e3d03D7bA18657DE97eE95Aa1a1654E925d4d
BUYER_PRIVATE_KEY=

SUPPLIER_1_ADDRESS=0x70Fe070a4de012974E465853C9C0BD03c7c8C738
SUPPLIER_1_PRIVATE_KEY=

SUPPLIER_2_ADDRESS=0xedc02C945539bD13b4c14f16C83411A72CF5747f
SUPPLIER_2_PRIVATE_KEY=

SUPPLIER_3_ADDRESS=0x6D78b4a808eFCD51a5Ca2b28297A511E655eD793
SUPPLIER_3_PRIVATE_KEY=

# Privy organization wallet.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
# Above this many USDC minor units, the key quorum has to sign.
PRIVY_QUORUM_CEILING=

# The buyer's service. PURCHASER_PORT is what it binds to; INTENT_MODEL reads the buyer's sentence.
PURCHASER_PORT=8788
INTENT_MODEL=claude-opus-5

# The payout cap is the policy's maximum price rounded up to the next whole PAYOUT_CAP_BUCKET.
# `transferFrom` is public, so the cap is what leaks: a reader learns which 250 USDC band the
# maximum price falls in and nothing sharper. MAX_PAYOUT_CAP is the largest cap the Privy spend
# policy will sign, so a buyer asking above 750 is refused by the organization, not by the service.
PAYOUT_CAP_BUCKET=250000000
MAX_PAYOUT_CAP=750000000

# The Privy organization wallet the buyer funds from. Create its spend policy with
# `pnpm --filter @perdiem/purchaser privy:policy create` and attach the id it prints, then
# check a wrong spender is refused with `pnpm --filter @perdiem/purchaser privy:policy probe`.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=

# Above this many USDC minor units, the key quorum signs instead of the server key.
PRIVY_QUORUM_CEILING=500000000

# P-256 authorization keys, base64 PKCS#8, comma-separated. Leave PRIVY_SERVER_KEYS empty when the
# spend policy alone authorizes at or under the ceiling. PRIVY_QUORUM_KEYS carries the travel
# manager and finance, in the order the quorum was created with; the service refuses to start with
# a MAX_PAYOUT_CAP above the ceiling and nobody to sign for it.
PRIVY_SERVER_KEYS=
PRIVY_QUORUM_KEYS=

# UI.
#
# Vite inlines anything prefixed VITE_ into the browser bundle, so only public values carry that
# prefix. These alias the values above, and bash expands them on `source`, so the lines have to
# stay below the ones they name.
#
#   set -a; source .env.localhost; set +a
#   pnpm --filter @perdiem/ui dev
VITE_ARC_RPC_URL=${ARC_RPC_URL}
VITE_SEALED_AUCTION_ADDRESS=${SEALED_AUCTION_ADDRESS}
VITE_RELAY_URL=${RELAY_URL}

VITE_EXPLORER_URL=

# The block the page starts reading logs from. Raise it on a long-lived deployment.
VITE_FROM_BLOCK=0
