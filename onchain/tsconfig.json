{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Nothing here is emitted: `build` is `hardhat compile`, and the scripts run through Hardhat's
    // own loader. Declarations would force a type annotation on every Ignition module.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  }
}
