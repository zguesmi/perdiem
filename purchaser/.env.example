# The buyer's side. Holds the policy secrets and the funding credentials, and nothing that belongs
# to a supplier.

PURCHASER_PORT=8788

# Intent parsing: one call, one retry.
ANTHROPIC_API_KEY=
INTENT_MODEL=claude-opus-5

# Privy organization wallet. Blocked on
# docs/scratch/verification/issues/06-privy-server-wallets-on-arc.md
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=

# Above this many USDC minor units, the key quorum has to sign.
PRIVY_QUORUM_CEILING=

# The enclave keypair. The private half is uploaded as a workflow secret and must never reach an
# agent. That this service holds it at all is a known limitation: see
# docs/scratch/build/issues/16-enclave-key-generation.md
ENCLAVE_PUBLIC_KEY=
ENCLAVE_PRIVATE_KEY=
