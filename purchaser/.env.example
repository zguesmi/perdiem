# The buyer's side. Holds the policy secrets and the funding credentials, and nothing that belongs
# to a supplier.
#
# The shared entries the service also reads — ARC_RPC_URL and SEALED_AUCTION_ADDRESS — live in the
# repository root `.env`.

PURCHASER_PORT=8788

# Intent parsing: one call, one retry.
ANTHROPIC_API_KEY=
INTENT_MODEL=claude-opus-5

# USDC minor units the buyer locks per auction. It has to sit above the policy's maximum price:
# `transferFrom` is public, so an exact cap would publish the ceiling the policy keeps private.
# It is also the maximum the spend policy will sign a `createAuction` for.
PAYOUT_CAP=750000000

# The Privy organization wallet, and the spend policy attached to it.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=

# Above this many USDC minor units, the key quorum signs instead of the server key.
PRIVY_QUORUM_CEILING=500000000

# P-256 authorization keys, base64 PKCS#8, comma-separated. Leave PRIVY_SERVER_KEYS empty when the
# spend policy alone authorizes at or under the ceiling. PRIVY_QUORUM_KEYS carries the travel
# manager and finance, in the order the quorum was created with.
PRIVY_SERVER_KEYS=
PRIVY_QUORUM_KEYS=

# The enclave keypair. The private half is uploaded as a workflow secret and must never reach an
# agent. That this service holds it at all is a known limitation: see
# docs/scratch/build/issues/16-enclave-key-generation.md
ENCLAVE_PUBLIC_KEY=
ENCLAVE_PRIVATE_KEY=
