# The workflow reads the relay and nothing writes to it from here.
#
# In simulation the policy and the enclave private key come from the CRE secrets file, not from this
# environment. Blocked on .scratch/verification/issues/04-workflow-secrets-in-simulation.md

RELAY_URL=http://localhost:8787
RELAY_READ_TOKEN=

# Blocked on .scratch/verification/issues/01-cre-simulate-writes-to-arc.md
CRE_FORWARDER_ADDRESS=
