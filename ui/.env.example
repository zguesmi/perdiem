# Vite exposes anything prefixed VITE_ to the browser, so only public values belong here.

VITE_ARC_RPC_URL=http://127.0.0.1:8545
VITE_SEALED_AUCTION_ADDRESS=
VITE_RELAY_URL=http://localhost:8787

# Optional. Empty on a local node, which has no explorer: hashes then render as plain text.
VITE_EXPLORER_URL=

# Optional. The block the page starts reading logs from. Raise it on a long-lived deployment.
VITE_FROM_BLOCK=0
