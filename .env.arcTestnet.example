# One file per network, named after the Hardhat network it targets. Copy this one to
# `.env.arcTestnet`
#   set -a; source .env.arcTestnet; set +a

ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002

ARC_PRIVATE_KEY=

# Filled in after deployment. Arc has a real USDC, so only the auction address is deployed.
SEALED_AUCTION_ADDRESS=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
USDC_DECIMALS=6

RELAY_PORT=8787
RELAY_URL=http://localhost:8787

# The suppliers price with a model, so every agent needs this.
ANTHROPIC_API_KEY=

BOOKING_URL=https://api.liteapi.travel/v3.0
BOOKING_API_KEY=

# The X25519 private half, base64, as the workflow secret carries it.
ENCLAVE_PRIVATE_KEY=

# Provision with `circle wallet login <email> --testnet`.
# One wallet per agent.
AGENT_SIGNER=circle
CIRCLE_WALLET_ADDRESS=

BUYER_ADDRESS=
BUYER_PRIVATE_KEY=

# UI.
#
# Vite inlines anything prefixed VITE_ into the browser bundle, so only public values carry that
# prefix. These alias the values above, and bash expands them on `source`, so the lines have to
# stay below the ones they name.
#
#   set -a; source .env.arcTestnet; set +a
#   pnpm --filter @perdiem/ui dev
VITE_ARC_RPC_URL=${ARC_RPC_URL}
VITE_SEALED_AUCTION_ADDRESS=${SEALED_AUCTION_ADDRESS}
VITE_RELAY_URL=${RELAY_URL}

VITE_EXPLORER_URL=https://testnet.arcscan.app

# The block the page starts reading logs from. Raise it on a long-lived deployment.
VITE_FROM_BLOCK=0
