# One file per network, named after the Hardhat network it targets. Copy this one to
# `.env.arcTestnet`
#   set -a; source .env.arcTestnet; set +a

ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002

# SealedAuction deployer.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# The CRE CLI signs the claim and the settlement with this one when `cre workflow simulate`
# runs with `--broadcast`. The deployer, because it is already funded on this network.
CRE_ETH_PRIVATE_KEY=

# Filled in after deployment. Arc has a real USDC, so only the auction address is deployed.
SEALED_AUCTION_ADDRESS=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
USDC_DECIMALS=6

SUPPLIER_STAKE=500000
BID_PERIOD_SECONDS=30
FINALIZE_PERIOD_SECONDS=1800

RELAY_PORT=8787
RELAY_URL=http://localhost:8787

# The suppliers price with a model, so every agent needs this.
ANTHROPIC_API_KEY=

BOOKING_URL=https://api.liteapi.travel/v3.0
BOOKING_API_KEY=

# The X25519 private half, base64, as the workflow secret carries it.
ENCLAVE_PRIVATE_KEY=

AGENT_SIGNER=circle

BUYER_ADDRESS=
BUYER_PRIVATE_KEY=
SUPPLIER_1_WALLET_ADDRESS=
SUPPLIER_2_WALLET_ADDRESS=
SUPPLIER_3_WALLET_ADDRESS=

# The buyer's service. PURCHASER_PORT is what it binds to; INTENT_MODEL reads the buyer's sentence.
# PURCHASER_URL is where the page reaches it, so it is the address a browser can resolve.
# PAGE_ORIGIN is the one origin it answers: the service holds the buyer's Privy keys, so any other
# page reaching it could fund an auction against a policy it wrote.
PURCHASER_PORT=8788
PURCHASER_URL=http://localhost:8788
PAGE_ORIGIN=http://localhost:5173
INTENT_MODEL=claude-opus-5

# The payout cap is the policy's maximum price rounded up to the next whole PAYOUT_CAP_BUCKET.
# `transferFrom` is public, so the cap is what leaks: a reader learns which bucket the maximum
# price falls in and nothing sharper. MAX_PAYOUT_CAP is the largest cap the Privy spend policy will
# sign, so a buyer asking above it is refused by the organization, not by the service.
PAYOUT_CAP_BUCKET=2500000
MAX_PAYOUT_CAP=7500000

# Two wallets, because a Privy wallet has one owner. PRIVY_WALLET_ID has none, so the spend policy
# is its whole authorization. PRIVY_QUORUM_WALLET_ID is owned by the travel manager and finance,
# who both sign every request to it.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
PRIVY_QUORUM_WALLET_ID=

# Above this many USDC minor units, the funding moves to the quorum wallet. The key quorum signs
# instead of the server key. At MAX_PAYOUT_CAP the quorum never fires and the spend policy
# authorizes every auction; lower it to put the quorum back in the path.
PRIVY_QUORUM_CEILING=7500000

# P-256 authorization keys, base64 PKCS#8, comma-separated. Leave PRIVY_SERVER_KEYS empty when the
# spend policy alone authorizes at or under the ceiling. PRIVY_QUORUM_KEYS carries the travel
# manager and finance, in the order the quorum was created with; the service refuses to start with
# a MAX_PAYOUT_CAP above the ceiling and nobody to sign for it.
PRIVY_SERVER_KEYS=
PRIVY_QUORUM_KEYS=

# UI.
#
# Vite inlines anything prefixed VITE_ into the browser bundle, so only public values carry that
# prefix. These alias the values above, and bash expands them on `source`, so the lines have to
# stay below the ones they name.
#
#   set -a; source .env.arcTestnet; set +a
#   pnpm --filter @perdiem/ui dev
VITE_SEALED_AUCTION_ADDRESS=${SEALED_AUCTION_ADDRESS}
VITE_RELAY_URL=${RELAY_URL}
VITE_PURCHASER_URL=${PURCHASER_URL}

VITE_EXPLORER_URL=https://testnet.arcscan.app

VITE_FROM_BLOCK=0
