# One file per network, named after the Hardhat network it targets. Copy this one to
# `.env.arcTestnet`
#   set -a; source .env.arcTestnet; set +a

ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002

# The deployer. Deploys SealedAuction and pays the gas for it.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Filled in after deployment. Arc has a real USDC, so only the auction address is deployed.
SEALED_AUCTION_ADDRESS=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
USDC_DECIMALS=6

RELAY_PORT=8787
RELAY_URL=http://localhost:8787

# The suppliers price with a model, so every agent needs this.
ANTHROPIC_API_KEY=

BOOKING_URL=https://api.liteapi.travel/v3.0
BOOKING_API_KEY=

# The workflow secrets. `workflow-cre/secrets.yaml` maps each id `handlerInTee` asks for to one of
# these variable names, and the CRE CLI refuses to compile when a named variable is missing, so both
# lines have to exist even while they are empty.
#
# ENCLAVE_PRIVATE_KEY is the X25519 private half, base64. POLICY is the canonical Policy JSON of the
# auction under settlement.
ENCLAVE_PRIVATE_KEY=
POLICY=

# Provision with `circle wallet login <email> --testnet`.
# One wallet per agent.
AGENT_SIGNER=circle
CIRCLE_WALLET_ADDRESS=

BUYER_ADDRESS=
BUYER_PRIVATE_KEY=

# The buyer's service. PURCHASER_PORT is what it binds to; INTENT_MODEL reads the buyer's sentence.
PURCHASER_PORT=8788
INTENT_MODEL=claude-opus-5

# The payout cap is the policy's maximum price rounded up to the next whole PAYOUT_CAP_BUCKET.
# `transferFrom` is public, so the cap is what leaks: a reader learns which 250 USDC band the
# maximum price falls in and nothing sharper. MAX_PAYOUT_CAP is the largest cap the Privy spend
# policy will sign, so a buyer asking above 750 is refused by the organization, not by the service.
PAYOUT_CAP_BUCKET=250000000
MAX_PAYOUT_CAP=750000000

# The Privy organization wallets the buyer funds from. Create their spend policy with
# `pnpm --filter @perdiem/purchaser privy:policy create` and attach the id it prints to both, then
# check what it refuses with `pnpm --filter @perdiem/purchaser privy:policy probe`.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Two wallets, because a Privy wallet has one owner. PRIVY_WALLET_ID has none, so the spend policy
# is its whole authorization. PRIVY_QUORUM_WALLET_ID is owned by the travel manager and finance,
# who both sign every request to it.
PRIVY_WALLET_ID=
PRIVY_QUORUM_WALLET_ID=

# Above this many USDC minor units, the funding moves to the quorum wallet.
PRIVY_QUORUM_CEILING=500000000

# P-256 authorization keys, base64 PKCS#8, comma-separated. PRIVY_SERVER_KEYS stays empty while
# PRIVY_WALLET_ID has no owner. PRIVY_QUORUM_KEYS carries the travel manager and finance, in the
# order the quorum was created with; the service refuses to start with a MAX_PAYOUT_CAP above the
# ceiling and nobody to sign for it.
PRIVY_SERVER_KEYS=
PRIVY_QUORUM_KEYS=

# UI.
#
# Vite inlines anything prefixed VITE_ into the browser bundle, so only public values carry that
# prefix. These alias the values above, and bash expands them on `source`, so the lines have to
# stay below the ones they name.
#
#   set -a; source .env.arcTestnet; set +a
#   pnpm --filter @perdiem/ui dev
VITE_ARC_RPC_URL=${ARC_RPC_URL}
VITE_SEALED_AUCTION_ADDRESS=${SEALED_AUCTION_ADDRESS}
VITE_RELAY_URL=${RELAY_URL}

VITE_EXPLORER_URL=https://testnet.arcscan.app

# The block the page starts reading logs from. Raise it on a long-lived deployment.
VITE_FROM_BLOCK=0
