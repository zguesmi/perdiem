# One supplier agent. Run three copies with three of these, one per rate plan.
#
# An agent holds its own key and nothing else. It never holds the policy or the enclave private key.

AGENT_RATE_PLAN=a

# Which signer this agent uses: `circle` is the demo path, `local` is the viem fallback.
AGENT_SIGNER=circle

# The agent's Circle Agent Stack wallet. Blocked on
# docs/scratch/verification/issues/07-circle-agent-stack-wallets.md
CIRCLE_API_KEY=
CIRCLE_WALLET_ID=

# The viem fallback signer's key. Demo keys only.
AGENT_PRIVATE_KEY=

RELAY_URL=http://localhost:8787

# Blocked on docs/scratch/verification/issues/09-liteapi-booking-id-and-payment-method.md
LITEAPI_SANDBOX_KEY=

# Set to 1 to price against the deterministic fake instead of the sandbox. The fake may run the
# agent; it may never produce the booking receipt.
LITEAPI_USE_FAKE=0
