# One supplier agent. Run three copies with three of these, one per configuration in config/.
#
# An agent holds its own key, its own booking credentials and nothing else. It never holds the
# policy or the enclave private key.

# The model that prices the bid.
ANTHROPIC_API_KEY=

# The viem fallback signer's key. Demo keys only.
AGENT_PRIVATE_KEY=

# Hotel identifiers, so the enclave has something it can book.
LITEAPI_SANDBOX_KEY=

# This supplier's own booking API. Sealed into the envelope; the enclave books the winner with it.
BOOKING_URL=https://api.liteapi.travel/v3.0
BOOKING_API_KEY=
