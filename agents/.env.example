# One supplier agent. Run three copies with three of these, one per rate plan.
#
# An agent holds a write-only relay token and its own key. It never holds the read token, the policy,
# or the enclave private key.

AGENT_RATE_PLAN=a

# This agent's key. Demo keys only.
AGENT_PRIVATE_KEY=

RELAY_URL=http://localhost:8787
RELAY_WRITE_TOKEN=

# Blocked on docs/scratch/verification/issues/09-liteapi-booking-id-and-payment-method.md
LITEAPI_SANDBOX_KEY=

# Set to 1 to price against the deterministic fake instead of the sandbox. The fake may run the
# agent; it may never produce the booking receipt.
LITEAPI_USE_FAKE=0
